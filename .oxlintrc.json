{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@foldkit/oxlint-plugin/recommended.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": [
    {
      "name": "taimei",
      "specifier": "./lint/oxlint-plugin.mts"
    },
    {
      "name": "foldkit",
      "specifier": "@foldkit/oxlint-plugin"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["/*", "!/web"],
  "rules": {
    "curly": ["error", "all"],
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "no-array-constructor": "error",
    "import/no-commonjs": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-namespace": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "taimei/no-switch": "error",
    "taimei/no-code-comment": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/repos/**", "repos/**"],
            "message": "repos/ は agent が読む Foldkit の source の写しで、本番の build に入らない。package (foldkit など) から import する"
          },
          {
            "group": ["effect/persistence", "effect/persistence/*"],
            "message": "画面の cache は Model (メモリ) だけに持つ。effect/persistence は使わない"
          },
          {
            "group": [
              "react",
              "react/*",
              "react-dom",
              "react-dom/*",
              "@effect/atom-react",
              "@effect/atom-react/*",
              "effect/reactivity",
              "effect/reactivity/*",
              "@tanstack/react-router",
              "lucide-react",
              "@radix-ui/*"
            ],
            "message": "Foldkit で書く file は React と Atom を使わない。状態は Model、通信は Command に置く"
          },
          {
            "group": ["effect/http"],
            "message": "handler は契約が decode した値を受け、成功の値を返す。effect/http を使えるのは、契約の web handler を組む src/spa-http-api.ts と、SPA の契約の client を作る web/src/shared/spa-http-client.ts だけ (ADR-0007)"
          },
          {
            "group": ["@sentry/*"],
            "message": "Sentry の SDK は Worker の入口 (src/worker.ts) だけが使う。報告は src/lib/report-error.ts の reportError"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["web/**"],
      "excludeFiles": ["web/src/**/__tests__/**"],
      "rules": {
        "taimei/no-effect-run-in-web": "error",
        "taimei/no-browser-global-outside-command": "error",
        "taimei/no-raw-form-element": "error",
        "taimei/no-raw-svg-element": "error",
        "taimei/no-direct-application-start": "error",
        "taimei/leave-spa-only-in-leave-spa": "error",
        "taimei/leave-spa-import-only-in-app": "error",
        "taimei/spa-http-client-only-in-foldkit-files": "error",
        "taimei/cause-lookup-only-in-failure-message": "error",
        "taimei/mutation-endpoint-only-in-mutation-module": "error",
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "never"
          }
        ],
        "taimei/no-timer-in-web": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "localStorage",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "name": "sessionStorage",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "name": "indexedDB",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "name": "caches",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "name": "cookieStore",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "document",
            "property": "cookie",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "property": "localStorage",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "property": "sessionStorage",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "property": "indexedDB",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "property": "cookieStore",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "object": "window",
            "property": "caches",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "object": "globalThis",
            "property": "caches",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          },
          {
            "object": "self",
            "property": "caches",
            "message": "web は browser の storage を使わない。画面の cache は Model (メモリ) だけに持つ"
          }
        ]
      }
    },
    {
      "files": ["**/__tests__/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["web/src/shared/ui/**"],
      "rules": {
        "taimei/no-raw-form-element": "off"
      }
    },
    {
      "files": ["web/src/app/start-application.ts"],
      "rules": {
        "taimei/no-direct-application-start": "off"
      }
    },
    {
      "files": ["web/prerender.ts"],
      "rules": {
        "taimei/no-effect-run-in-web": "off"
      }
    },
    {
      "files": ["web/src/main.ts"],
      "rules": {
        "taimei/no-browser-global-outside-command": "off"
      }
    },
    {
      "files": ["web/src/app/*/entry.ts"],
      "rules": {
        "taimei/no-browser-global-outside-command": "off",
        "taimei/spa-http-client-only-in-foldkit-files": "off"
      }
    },
    {
      "files": ["web/src/app/**"],
      "rules": {
        "taimei/leave-spa-import-only-in-app": "off"
      }
    },
    {
      "files": ["web/src/shared/leave-spa.ts"],
      "rules": {
        "taimei/no-browser-global-outside-command": "off",
        "taimei/leave-spa-only-in-leave-spa": "off"
      }
    },
    {
      "files": ["web/src/shared/failure-message.ts"],
      "rules": {
        "taimei/cause-lookup-only-in-failure-message": "off"
      }
    },
    {
      "files": ["web/src/dashboard/mutation.ts"],
      "rules": {
        "taimei/mutation-endpoint-only-in-mutation-module": "off"
      }
    },
    {
      "files": ["web/src/shared/ui/icon-view.ts"],
      "rules": {
        "taimei/no-raw-svg-element": "off"
      }
    }
  ]
}
