{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["web/src/main.tsx", "testing/worker.ts"],
  "ignoreDependencies": ["pg", "@effect/tsgo", "@taimei-code/auth-client"],
  "boundaries": {
    "zones": [
      {
        "name": "contract",
        "patterns": ["src/spa-contract.ts", "db/ids.ts", "db/column-values.ts"]
      },
      {
        "name": "server",
        "patterns": ["src/**", "db/**"]
      },
      {
        "name": "spa",
        "patterns": ["web/src/**"]
      },
      {
        "name": "non-production",
        "patterns": ["testing/**"]
      }
    ],
    "rules": [
      {
        "from": "spa",
        "allow": ["contract"],
        "allowTypeOnly": []
      },
      {
        "from": "contract",
        "allow": ["contract"],
        "allowTypeOnly": ["server"]
      },
      {
        "from": "server",
        "allow": ["server", "contract"],
        "allowTypeOnly": []
      }
    ]
  }
}
