{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/build/**",
      "!**/coverage/**",
      "!**/*.generated.*",
      "!drizzle/migrations/**",
      "!e2e/playwright-report/**",
      "!e2e/test-results/**",
      "!repos",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!web/**",
      "web/**/*.tsx",
      "web/vite.config.ts",
      "web/tailwind.config.ts",
      "web/postcss.config.mjs",
      "web/src/api.ts",
      "web/src/api-internal.ts",
      "web/src/lib/utils.ts",
      "web/src/dashboard/level.ts",
      "web/src/dashboard/skill-matrix.ts",
      "web/src/privacy/facts.ts",
      "web/src/__tests__/api.test.ts",
      "web/src/__tests__/memory-only-cache.test.ts",
      "web/src/__tests__/router.test.ts",
      "web/src/__tests__/spa-bundle.test.ts",
      "web/src/dashboard/__tests__/level.test.ts",
      "web/src/dashboard/__tests__/skill-matrix.test.ts",
      "web/src/privacy/__tests__/facts.test.ts",
      "web/src/privacy/__tests__/privacy-page.test.ts"
    ],
    "rules": {
      "preset": "none",
      "complexity": {
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "warn",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "style": {
        "noCommonJs": "error",
        "noNamespace": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/drizzle/pool", "./pool"],
                "message": "要求ごとの Pool を開く db/drizzle/pool は Worker の入口 (src/worker.ts) と db/drizzle/client.ts だけが使う。query は db/drizzle/client.ts の db で書く"
              },
              {
                "group": ["effect/http"],
                "message": "handler は契約が decode した値を受け、成功の値を返す。effect/http を使えるのは、契約の web handler を組む src/spa-http-api.ts と、SPA の契約の client を作る web/src/shared/spa-http-client.ts だけ (ADR-0007)"
              },
              {
                "group": ["@sentry/*"],
                "message": "Sentry の SDK は Worker の入口 (src/worker.ts) だけが使う。報告は src/lib/report-error.ts の reportError"
              }
            ]
          }
        },
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnusedExpressions": "off",
        "useNamespaceKeyword": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.spec.ts", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["*.ts", "*.mts", "*.cts"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "error"
          },
          "correctness": {
            "noConstAssign": "off",
            "noGlobalObjectCalls": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noInvalidConstructorSuper": "off",
            "noSetterReturn": "off",
            "noUndeclaredVariables": "off",
            "noUnreachable": "off",
            "noUnreachableSuper": "off"
          },
          "style": {
            "useConst": "error"
          },
          "suspicious": {
            "noClassAssign": "off",
            "noDuplicateClassMembers": "off",
            "noDuplicateObjectKeys": "off",
            "noDuplicateParameters": "off",
            "noFunctionAssign": "off",
            "noImportAssign": "off",
            "noRedeclare": "off",
            "noUnsafeNegation": "off",
            "noVar": "error",
            "noWith": "off",
            "useGetterReturn": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": [
    "./biome-plugins/no-switch.grit",
    {
      "path": "./biome-plugins/report-through-report-error.grit",
      "includes": [
        "**/src/**",
        "**/db/**",
        "!**/__tests__/**",
        "!**/src/lib/report-error.ts"
      ]
    }
  ]
}
