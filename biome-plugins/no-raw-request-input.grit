language js

`$c.req.$member` where {
  $member <: or {
    `param`,
    `query`,
    `queries`,
    `json`,
    `header`,
    `text`,
    `formData`,
    `parseBody`,
    `arrayBuffer`,
    `blob`,
    `raw`
  },
  register_diagnostic(span=$member, message="生の入力を読まない。route に validator (hono/validator) を付け、c.req.valid の値を使う")
}
